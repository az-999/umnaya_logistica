{
  "info": {
    "name": "Notification Service",
    "description": "API микросервиса массовых уведомлений",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "notification_id",
      "value": ""
    },
    {
      "key": "subscriber_id",
      "value": "sub-001"
    }
  ],
  "item": [
    {
      "name": "Bulk SMS (transactional)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data[0]) {",
              "  pm.collectionVariables.set('notification_id', json.data[0].id);",
              "  pm.collectionVariables.set('subscriber_id', json.data[0].subscriber_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"sms\",\n  \"message\": \"Ваш код: 1234\",\n  \"recipient_ids\": [\"sub-001\"],\n  \"priority\": \"transactional\"\n}"
        },
        "url": "{{base_url}}/notifications/bulk"
      }
    },
    {
      "name": "Bulk Email (marketing)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"email\",\n  \"message\": \"Скидка 20% на доставку!\",\n  \"recipient_ids\": [\"sub-001\", \"sub-002\"],\n  \"priority\": \"marketing\"\n}"
        },
        "url": "{{base_url}}/notifications/bulk"
      }
    },
    {
      "name": "Bulk SMS (idempotent retry)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"sms\",\n  \"message\": \"Ваш код: 1234\",\n  \"recipient_ids\": [\"sub-001\"],\n  \"priority\": \"transactional\"\n}"
        },
        "url": "{{base_url}}/notifications/bulk"
      }
    },
    {
      "name": "Subscriber notifications history",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/subscribers/{{subscriber_id}}/notifications?status=&channel=",
          "host": ["{{base_url}}"],
          "path": ["subscribers", "{{subscriber_id}}", "notifications"],
          "query": [
            {
              "key": "status",
              "value": ""
            },
            {
              "key": "channel",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "Delivery callback (delivered)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"delivered\"\n}"
        },
        "url": "{{base_url}}/notifications/{{notification_id}}/delivery-callback"
      }
    }
  ]
}
